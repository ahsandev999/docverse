# =============================================================
# DocVerse Environment Variables
# =============================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# ---- Clerk Authentication ----
# Get these from https://dashboard.clerk.com
# After creating a new application, go to API Keys.
# The publishable key is safe for the browser (starts with pk_test_ or pk_live_).
# The secret key is server-only (starts with sk_test_ or sk_live_).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CLERK_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ---- Neon PostgreSQL Database ----
# Get these from https://console.neon.tech
# Create a new project, then copy the connection strings.
# DATABASE_URL = Pooled connection (uses pooler endpoint, ends with -pooler)
# DIRECT_URL  = Direct connection (uses the regular endpoint)
DATABASE_URL=postgresql://username:password@ep-cool-name-123456.us-east-2.aws.neon.tech/docverse?sslmode=require
DIRECT_URL=postgresql://username:password@ep-cool-name-123456.us-east-2.aws.neon.tech/docverse?sslmode=require

# ---- Optional ----
# VITE_APP_URL=http://localhost:5173
